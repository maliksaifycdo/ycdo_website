{
  "name": "ycdo-website",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "node init && npm run dev --workspace=apps/frontend",
    "dev:backend": "node init && npm run start:dev --workspace=apps/backend",
    "dev": "node init && concurrently npm:dev:frontend npm:dev:backend",
    "build": "node init && npm run build --workspaces",
    "lint": "npm run lint -w apps/frontend && npm run lint -w apps/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
